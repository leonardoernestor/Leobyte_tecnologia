{
	"$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
	"name": "leobyte-tecnologia-chat",
	"main": "worker.js",
	"compatibility_date": "2026-11-05",
	"workers_dev": true,
	"ai": {
		"binding": "AI"
	},
	"ratelimits": [
		{
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "176988613",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	]
}
